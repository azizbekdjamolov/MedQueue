# Telegram Bot API token (create one with @BotFather).
# Never commit the real value — keep it only in .env (gitignored).
TELEGRAM_BOT_TOKEN=

# Public HTTPS URL of the website. Used for the bot's
# "Open Website" button and the Telegram Mini App button.
# NOTE: Telegram requires HTTPS for web_app buttons in production.
TELEGRAM_WEBAPP_URL=https://medqueue.example.com

# Comma-separated list of frontend origins allowed to call the API.
FRONTEND_ORIGIN=http://localhost:5173

# Port the backend API listens on.
PORT=3001

# Shared AI service (OpenAI-compatible chat completions).
# Never expose these to the browser — the React app only talks to /api/chat.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Web search provider for the AI assistant.
# Options: duckduckgo (default, no key) | tavily | brave | serpapi
# Keys below are only needed for the matching provider.
SEARCH_PROVIDER=duckduckgo
TAVILY_API_KEY=
BRAVE_API_KEY=
SERPAPI_API_KEY=

# How often simulated queues advance (ms).
MEDQUEUE_TICK_MS=30000

# Authentication (zero extra dependencies — scrypt hashing, httpOnly cookies).
# User accounts persist in server/data/users.json (gitignored). Sessions live
# in memory; registered users' medical records are empty until clinic data
# exists, so cabinets show realistic empty states.
# AUTH_SESSION_REMEMBER_DAYS=30